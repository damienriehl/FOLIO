<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
<owl:Class rdf:about="https://folio.openlegalstandard.org/parent"><rdfs:label>Contractual Obligation</rdfs:label><skos:definition></skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/breach"><rdfs:label>Breach of Contract</rdfs:label><skos:definition>Failure without lawful excuse to perform a contractual obligation covenant or fulfill an agreement between parties creating legally binding obligations</skos:definition><rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/parent"/></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/real"><rdfs:label>Real Property</rdfs:label><skos:definition>In legal contexts property rights in land and attached improvements</skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/tenant"><rdfs:label>Tenant</rdfs:label><skos:definition>A person who rents and occupies real property under a lease or rental agreement</skos:definition><skos:altLabel xml:lang="fr-fr">locataire</skos:altLabel></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/license"><rdfs:label>License (Agreement)</rdfs:label><skos:definition>Legal permission agreement</skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/agreements"><rdfs:label>Agreements / Contracts</rdfs:label><skos:definition>A written or spoken agreement between two or more parties that creates legally binding obligations</skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/alias"><rdfs:label>Pact</rdfs:label><skos:definition>A written or spoken agreement between two or more parties that creates legally binding obligations</skos:definition><skos:altLabel>Contract</skos:altLabel></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/deprecated"><rdfs:label>Contract</rdfs:label><skos:definition>A written or spoken agreement between two or more parties that creates legally binding obligations</skos:definition><owl:deprecated>true</owl:deprecated></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/pref"><rdfs:label>Document</rdfs:label><skos:definition>A written or spoken agreement between two or more parties that creates legally binding obligations</skos:definition><skos:prefLabel xml:lang="EN-us">Contract</skos:prefLabel></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/empty"><rdfs:label>Unknown Thing</rdfs:label><skos:definition></skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/material-breach"><rdfs:label>Material Breach of Contract</rdfs:label><skos:definition>Failure to fulfill a contractual obligation or covenant</skos:definition><rdfs:subClassOf rdf:resource="https://folio.openlegalstandard.org/parent"/></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/unclassified"><rdfs:label>Unclassified Term</rdfs:label><skos:definition>An unclassified term</skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/landlord"><rdfs:label>Landlord</rdfs:label><skos:definition>One who lets land to another: the owner or holder of land or houses which he leases or rents to another.</skos:definition></owl:Class>
<owl:Class rdf:about="https://folio.openlegalstandard.org/property"><rdfs:label>Property</rdfs:label></owl:Class>
</rdf:RDF>
