# ontokit-web Railway environment variables

# === NextAuth.js ===
AUTH_SECRET=  # Generate with: openssl rand -base64 32
AUTH_URL=https://your-ontokit-web.up.railway.app

# === Zitadel OIDC (same instance as ontokit-api) ===
ZITADEL_ISSUER=https://your-zitadel-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# === API URLs (set as build args in railway.toml, but also needed at runtime) ===
NEXT_PUBLIC_API_URL=https://your-ontokit-api.up.railway.app
NEXT_PUBLIC_WS_URL=wss://your-ontokit-api.up.railway.app
