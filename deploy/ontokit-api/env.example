# ontokit-api Railway environment variables
# Set these in the Railway dashboard. Use Railway's variable references
# for managed services (e.g., ${{Postgres.DATABASE_URL}}).

# === Database (Railway managed PostgreSQL) ===
# Railway auto-provides this when you add a Postgres plugin:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# === Redis (Railway managed Redis) ===
# Railway auto-provides this when you add a Redis plugin:
REDIS_URL=${{Redis.REDIS_URL}}

# === Object Storage (Cloudflare R2 — S3-compatible) ===
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ontokit-files
# Set S3_REGION to "auto" for R2
S3_REGION=auto

# === Authentication (Zitadel OIDC) ===
ZITADEL_ISSUER=https://your-zitadel-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# === Git repo storage ===
# Railway persistent volume mounted at this path
GIT_REPOS_PATH=/data/repos

# === Application ===
ENVIRONMENT=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://your-ontokit-web.up.railway.app
