{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.openlegalstandard.org/schemas/hydration-delta.schema.json",
  "title": "FOLIO hydration delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_hash", "schema_version", "run_id", "attempt_id", "parent_hashes", "baseline_hash", "candidate_hash", "policy_hash", "tool_hash", "status", "payload"],
  "properties": {
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "folio-hydration-delta/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "parent_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "minLength": 1},
    "tool_hash": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "failed", "incomplete", "stale"]},
    "payload": {
      "type": "object",
      "required": ["records", "record_count", "unrelated_semantic_drift"],
      "properties": {
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "record_count": {"type": "integer", "minimum": 0},
        "unrelated_semantic_drift": {"type": "array", "items": {"type": "array", "prefixItems": [{"enum": ["added", "removed"]}, {"type": "string"}, {"type": "string"}, {"type": "string"}], "items": false}}
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["record_id", "change", "locator", "before_hash", "after_hash", "before", "after"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "change": {"enum": ["added", "removed", "retagged", "replaced"]},
        "locator": {"type": "object"},
        "before_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "after_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "before": {"type": ["object", "null"]},
        "after": {"type": ["object", "null"]}
      }
    }
  }
}
