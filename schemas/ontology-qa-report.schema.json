{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.openlegalstandard.org/schemas/ontology-qa-report.schema.json",
  "title": "FOLIO ontology QA release report",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_hash", "schema_version", "run_id", "attempt_id", "parent_hashes", "baseline_hash", "candidate_hash", "policy_hash", "tool_hash", "status", "payload"],
  "properties": {
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "folio-ontology-qa-report/v1"},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "parent_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string"},
    "tool_hash": {"type": "string"},
    "status": {"enum": ["complete", "failed", "incomplete", "stale"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_decision", "record_count", "record_states", "stage_hashes", "evidence_summary", "claim"],
      "properties": {
        "release_decision": {"enum": ["merge_gate_passed", "blocked"]},
        "record_count": {"type": "integer", "minimum": 0},
        "record_states": {"type": "object", "additionalProperties": {"type": "string"}},
        "stage_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "evidence_summary": {
          "type": "object",
          "required": ["deterministic_compliance", "cross_provider_concordance", "eval_qualification", "legacy_surveillance", "residual_model_risk"],
          "properties": {
            "deterministic_compliance": {"type": "boolean"},
            "cross_provider_concordance": {"type": "boolean"},
            "eval_qualification": {"type": "boolean"},
            "legacy_surveillance": {"type": "boolean"},
            "residual_model_risk": {"type": "string", "minLength": 1}
          }
        },
        "claim": {"const": "Automated QA evidence; not expert legal certification."}
      }
    }
  }
}
